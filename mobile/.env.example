# Copy this file to .env, then replace each placeholder value.
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# The FastAPI backend. Use http://localhost:8000 for a local backend, or the
# deployed Function URL (the FreshPlateApi stack's ApiUrl output) to demo
# from a phone. See docs/deployment.md.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Legacy fallback during the Supabase API key migration:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
