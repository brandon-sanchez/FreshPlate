# Copy this file to .env, then replace each placeholder value.

# App
DEBUG=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Local corpus loader only. Never use this key in the mobile app or commit it.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Gemini
GEMINI_API_KEY=your-gemini-key

# Optional LangSmith tracing. LangGraph reads these variables directly.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=freshplate
